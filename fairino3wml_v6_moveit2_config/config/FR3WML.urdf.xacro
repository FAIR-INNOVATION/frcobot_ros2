<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="FR3WML">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import FR3WML urdf file -->
    <xacro:include filename="$(find fairino_description)/urdf/FR3WML.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="FR3WML.ros2_control.xacro" />


    <xacro:FR3WML_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
