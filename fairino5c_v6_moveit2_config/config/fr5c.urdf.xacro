<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr5c">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fr5c urdf file -->
    <xacro:include filename="$(find fairino_description)/urdf/fr5c.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fr5c.ros2_control.xacro" />


    <xacro:fr5c_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
