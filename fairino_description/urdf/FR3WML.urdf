  <joint name="robotdigg_right_finger_joint" type="fixed">
    <origin xyz="0 -0.0555814 0.098" rpy="0.375752 0 0" />
    <parent link="robotdigg_gripper_base" />
    <child link="robotdigg_right_finger" />
  </joint>

  <!-- TCP at the center of the open gap and gripping-pad length. -->
  <link name="robotdigg_tcp" />
  <joint name="robotdigg_tcp_joint" type="fixed">
    <origin xyz="0 0 0.098" rpy="0 0 0" />
    <parent link="robotdigg_gripper_base" />
    <child link="robotdigg_tcp" />
  </joint>
