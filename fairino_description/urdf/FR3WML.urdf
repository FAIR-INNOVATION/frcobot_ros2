  </link>
  <joint name="robotdigg_left_finger_joint" type="fixed">
    <origin xyz="0 0.0555814 0.098" rpy="-0.375752 0 0" />
    <parent link="robotdigg_gripper_base" />
    <child link="robotdigg_left_finger" />
  </joint>

  <link name="robotdigg_right_finger">
