  <!--
    Approximate RobotDigg gripper in its open configuration.

    Frame convention:
      +Z points from the flange into the gripper (approach axis).
      +Y points across the gap (finger closing axis).
      +X completes the right-handed frame.

    The 140 mm TCP offset is measured to the middle of the fingers. The whole
    gripper is rotated 45 degrees around flange Z. The fixed fingers represent
    their open state, flaring from a 60 mm gap at their bases to a 140 mm gap
    at their ends. The palm ends approximately 3 mm before the finger boxes.
    Their dimensions remain approximations pending measurements of the gripper.
  -->
  <link name="robotdigg_gripper_base">
    <visual>
      <geometry>
        <box size="0.070 0.090 0.084" />
      </geometry>
      <material name="robotdigg_gripper_base_material">
        <color rgba="0.65 0.65 0.65 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.070 0.090 0.084" />
      </geometry>
    </collision>
  </link>
  <joint name="robotdigg_gripper_base_joint" type="fixed">
    <!-- Place the palm against the flange and apply the physical 45 degree twist. -->
    <origin xyz="0 0 0.042" rpy="0 0 0.785398" />
    <parent link="flange_Link" />
    <child link="robotdigg_gripper_base" />
  </joint>

  <link name="robotdigg_left_finger">
    <visual>
      <geometry>
        <box size="0.025 0.012 0.109" />
      </geometry>
      <material name="robotdigg_left_finger_material">
        <color rgba="0.25 0.25 0.25 1" />
